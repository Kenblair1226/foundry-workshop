# ============================================================================
# Azure AI Foundry Workshop - environment configuration
# Copy this file to `.env` and fill in the values from your Foundry project.
#   cp .env.example .env
# NEVER commit your real .env file (it is git-ignored).
# ============================================================================

# --- Azure AI Foundry project ---
# Found in the Foundry portal: Project > Overview > "Project connection string"
# or the project endpoint URL. Format examples shown below.
AZURE_AI_PROJECT_ENDPOINT="https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project-name>"
# Legacy/alternate: region.api.azureml.ms;<subscription-id>;<resource-group>;<project-name>
AZURE_AI_PROJECT_CONNECTION_STRING=""

# --- Model deployments (names you chose when deploying in the portal) ---
CHAT_MODEL_DEPLOYMENT="gpt-4o"
EMBEDDING_MODEL_DEPLOYMENT="text-embedding-3-large"

# --- Direct inference endpoint (optional, used by azure-ai-inference samples) ---
# Project > Models + endpoints > your deployment > "Target URI" and "Key"
AZURE_INFERENCE_ENDPOINT="https://<your-resource>.services.ai.azure.com/models"
AZURE_INFERENCE_API_KEY=""
AZURE_INFERENCE_API_VERSION="2024-05-01-preview"

# --- Azure AI Search (Lab 04 - RAG) ---
AZURE_SEARCH_ENDPOINT="https://<your-search-service>.search.windows.net"
AZURE_SEARCH_API_KEY=""
AZURE_SEARCH_INDEX_NAME="workshop-rag-index"

# --- Optional: Application Insights connection string for tracing ---
APPLICATIONINSIGHTS_CONNECTION_STRING=""
